HOST=127.0.0.1
PORT=8787
DUBUSEEK_CDP=http://127.0.0.1:9333
DUBUSEEK_DATA_DIR=./data

# No API key is required — any /v1 request works without one.
# If you set DUBUSEEK_API_KEY anyway, it is ignored.

# Runtime credential/session paths. Keep them outside version control.
# DUBUSEEK_AUTH_FILE=./data/auth.json
# DUBUSEEK_SESSION_FILE=./data/sessions.json
# DUBUSEEK_CHROME_PROFILE=./data/chrome-profile

# Manual token import (simplest option: no login flow at all).
# Log in to chat.deepseek.com once in your browser, open DevTools >
# Application > Local Storage > chat.deepseek.com > userToken, and copy the
# value - either the raw token or the whole JSON string
# {"value":"...","__version":"0"}; both are accepted.
# DUBUSEEK_USER_TOKEN=eyJhbGciOi...
# Optional but recommended: the Cookie request header from any DeepSeek API
# call (DevTools > Network > any /api/v0 request > Request Headers > cookie).
# DUBUSEEK_COOKIE=sessionid=...; userToken=...

# If no token is configured and you run Dubuseek interactively (TTY), you are
# prompted to paste the userToken on first run. A working token is saved to
# data/auth.json and reused on later runs; if it stops working, you are asked
# again. Press Enter or run non-interactively (CI) to skip the prompt and fall
# back to the saved session / browser login flows.

# Automatic login (no browser interaction needed on later runs).
# Set both values and Dubuseek signs in to DeepSeek by itself.
# DUBUSEEK_LOGIN_EMAIL=you@example.com
# DUBUSEEK_LOGIN_PASSWORD=your-password
# Alternative to the two variables above: a JSON file with
# {"email": "you@example.com", "password": "your-password"} (mode 0600).
# DUBUSEEK_CREDENTIALS_FILE=./data/credentials.json
# Set to 0 to disable auto-login and always log in by hand.
# DUBUSEEK_AUTO_LOGIN=1

# Browser and upstream overrides.
# DUBUSEEK_SHOW_BROWSER=0
# DUBUSEEK_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# DUBUSEEK_POW_JS=https://fe-static.deepseek.com/chat/static/76608.8f2a9fa413.js
# DUBUSEEK_BASE_URL=https://chat.deepseek.com

# Diagnostics and prompt-tool behavior.
# DUBUSEEK_DEBUG=1
# DUBUSEEK_TOOL_REASONING=hidden

{
  "name": "dubuseek",
  "version": "0.1.0",
  "description": "Dubuseek - unofficial local OpenAI-compatible API for authenticated chat.deepseek.com web sessions, with automatic login",
  "type": "module",
  "private": false,
  "bin": {
    "dubuseek": "dist/index.js",
    "dub": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts start",
    "start": "node dist/index.js start",
    "login": "node dist/index.js login",
    "logout": "node scripts/logout.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/check-comments.mjs && node scripts/check-source-lines.mjs && eslint \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@captcha-libs/capsolver": "^2.2.1",
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "dubuseek",
    "deepseek",
    "openai-compatible",
    "responses-api",
    "chat-completions",
    "auto-login",
    "typescript",
    "proxy"
  ],
  "license": "MIT",
  "author": "Dubuseek contributors"
}
